{
  "name": "create-brass",
  "version": "1.2.1",
  "private": false,
  "type": "module",
  "bin": {
    "create-brass": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node dist/index.js",
    "audit:dependencies": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "validate:release-policy": "node scripts/check-release-policy.mjs",
    "validate:beta-version": "node scripts/prepare-beta.mjs 1.3.0-beta.0",
    "validate:evidence": "node scripts/check-beta-evidence.mjs",
    "test:evidence": "node scripts/test-beta-evidence.mjs",
    "test:templates": "node scripts/validate-templates.mjs",
    "test:templates:rollback": "node scripts/validate-templates.mjs --stable-facade",
    "test:templates:v2-beta": "node scripts/validate-templates.mjs --beta-facade",
    "test:templates:v1-bridge": "node scripts/validate-templates.mjs --v1-facade"
  },
  "dependencies": {
    "picocolors": "^1.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "conventional-changelog-conventionalcommits": "^7.x.x",
    "tsup": "^8.2.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
